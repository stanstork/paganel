// Release smoke test: CSV -> PostgreSQL on a fresh runner, no Docker.
// Exercises the real write path (COPY), checkpoints, integrity receipts and
// verify, with a transform and a filter so the plan has something to show.

connection "src" {
  driver    = "csv"
  url       = ".github/smoke/customers.csv"
  pk_column = "id"
}

connection "dst" {
  driver = "postgres"
  url    = env("POSTGRES_URL")
}

pipeline "smoke_customers" {
  from { connection = connection.src table = "customers" }
  to   { connection = connection.dst table = "smoke_customers" mode = "replace" }

  select {
    id        = customers.id
    name      = customers.name
    email     = lower(trim(customers.email))
    balance   = customers.balance
    active    = customers.active
    signed_up = customers.signed_up
  }
  
  settings { create_missing_tables = true }
}
